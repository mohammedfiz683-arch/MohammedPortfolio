     /P 5252 0 R
     /S /P
     /Pg 1074 0 R
     /Type /StructElem
  >>
endobj

5244 0 obj
  << /ActualText (The second idea is a game\055selection station designed to introduce players to a role\055playing experience\056 The machine is preloaded with a variety of games\054 each with its setting\054 characters and roles\056 A visitor approaches the installation\054 chooses which game they want to play using the buttons\054 and confirms their selection\056 The system then prints a script that guides the assignment of a role within the chosen game\056 With no screen or stored profile\054 the printed slip becomes the only output\056 The visitor tears it off and carries it into another space\054 where the role becomes the starting point for play\056)
     /K [ 6 ]
     /P 5245 0 R
     /Pg 1074 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

5245 0 obj
  << /K [ 5244 0 R ]
     /P 5252 0 R
     /S /P
     /Pg 1074 0 R
     /Type /StructElem
  >>
endobj

